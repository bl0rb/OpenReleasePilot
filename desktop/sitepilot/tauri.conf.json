{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenSitePilot",
  "mainBinaryName": "OpenSitePilot",
  "version": "0.5.1",
  "identifier": "io.github.bl0rb.opensitepilot",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenSitePilot",
        "url": "site.html",
        "width": 1080,
        "height": 800,
        "minWidth": 860,
        "minHeight": 560,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "copyright": "© 2026 bl0rb · MIT License · github.com/bl0rb/OpenReleasePilot",
    "shortDescription": "Update a static website with Claude Code, build it and publish it by SFTP",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": null
    }
  }
}
